{
  "id": "deckprobe-pdf-deep",
  "displayName": "DeckProbe PDF 全量深度探测",
  "profile": "probe",
  "adapter": {
    "type": "command",
    "command": ["./target/debug/deckprobe", "-l", "deep", "-t", "@all", "{input}"],
    "cwd": "{repo}",
    "timeoutSeconds": 15,
    "result": {"type": "stdout_json"}
  }
}
